# 로컬 실행에서 쓰려면 이 파일을 .env.local 로 복사해 값을 채운다 (.env.local 은 git 에 올라가지 않는다).
# 배포본에는 Vercel → Project → Settings → Environment Variables 에 같은 이름으로 넣는다.

# 관리자 모드 비밀번호.
#  · 로컬: 비워 두면 비밀번호 없이 들어간다.
#  · Vercel: 반드시 넣어야 한다. 없으면 관리자 모드가 잠긴다.
ADMIN_PASSWORD=

# Upstash Redis 연결값. Vercel → Storage 에서 Upstash Redis 를 프로젝트에 연결하면 Vercel 이 자동으로 넣어준다.
# 로컬에 채우면 로컬도 배포본과 같은 데이터를 쓴다. 비워 두면 로컬은 data 폴더에 저장한다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
